#!/usr/bin/env python3
"""cc-gate: the only program the Infinite AI Command Center can run on a server.

Install it as the forced command of the Command Center's SSH key:

    command="/usr/local/bin/cc-gate",restrict ssh-ed25519 AAAA... infinite-command-center

sshd then runs this program for every connection, whatever command the client
asked for, and passes that request in SSH_ORIGINAL_COMMAND. The request must be

    cc-gate v1 <operation> [arguments...]

Only the operations in OPS exist; their arguments are checked against strict
patterns and the root-owned configuration (/etc/cc-gate/config.json); programs
are started without a shell. Operations that change anything are refused unless
the configuration sets "allow_changes": true. The gate never runs as root, and
never runs a site's commands as root or as its own account: WP-CLI runs as the
site's user through cc-wp, which gives it an environment the site cannot change.

Each operation has a time budget (timeout_seconds, or slow_timeout_seconds for
the slow ones). When it runs out, the program is asked to stop (SIGTERM, which
sudo passes on because the program runs in its own session), then killed, and
the answer says the operation may not have finished.

Answers are one JSON object on stdout. Exit status: 0 done, 1 the operation
failed, 2 the request was refused.

Requires Python 3.6+ (on EL8/EL9 /usr/libexec/platform-python is always present).
"""

import datetime
import json
import os
import pwd
import re
import selectors
import shlex
import socket
import stat
import subprocess
import sys
import time
from urllib.parse import urlsplit

GATE_VERSION = "1.1.0"
CONFIG_PATH = "/etc/cc-gate/config.json"
# The configuration decides what the gate may do, so only root may be able to change it.
REQUIRE_ROOT_OWNED_CONFIG = True
SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

SITE_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,99}$")
SERVICE_RE = re.compile(r"^[a-z0-9][a-z0-9@._-]{0,63}$")
ONOFF = ("on", "off")

# operation -> (kind, argument names). kind "read" never changes anything;
# kind "change" needs "allow_changes": true. The Command Center keeps an
# identical table (backend/app/ssh/ops.py); a test checks they match.
OPS = {
    "hello": ("read", []),
    "system_overview": ("read", []),
    "service_status": ("read", ["service"]),
    "wp_core_version": ("read", ["site"]),
    "wp_core_verify": ("read", ["site"]),
    "wp_plugin_list": ("read", ["site"]),
    "wp_theme_list": ("read", ["site"]),
    "wp_admins": ("read", ["site"]),
    "wp_site_urls": ("read", ["site"]),
    "wp_maintenance_status": ("read", ["site"]),
    "wp_debug_log_status": ("read", ["site"]),
    "wp_db_export": ("change", ["site"]),
    "wp_set_site_urls": ("change", ["site"]),
    "wp_plugin_deactivate": ("change", ["site", "slug"]),
    "wp_plugin_activate": ("change", ["site", "slug"]),
    "wp_plugin_update": ("change", ["site", "slug"]),
    "wp_plugin_reinstall": ("change", ["site", "slug"]),
    "wp_core_reinstall": ("change", ["site"]),
    "wp_maintenance": ("change", ["site", "onoff"]),
    "wp_cache_flush": ("change", ["site"]),
    "wp_rewrite_flush": ("change", ["site"]),
    "debug_log_quarantine": ("change", ["site"]),
    "service_restart": ("change", ["service"]),
}
SLOW_OPS = {"wp_core_verify", "wp_plugin_update", "wp_plugin_reinstall", "wp_core_reinstall", "wp_db_export", "debug_log_quarantine"}
STOP_GRACE_SECONDS = 10
# Either one lets a user take over the site; a custom or edited role can carry them without being "administrator".
ADMIN_CAPABILITIES = "manage_options,promote_users"
# Update URI values WordPress itself treats as WordPress.org.
WPORG_UPDATE_URI = re.compile(r"^(https?://)?(www\.)?(w\.org|wordpress\.org)(/|$)", re.I)


class Refused(Exception):
    """The request is not allowed (exit status 2)."""


class Failed(Exception):
    """The operation ran and failed (exit status 1)."""


class TimedOut(Failed):
    """The operation ran out of time and was stopped; it may have been partly done."""


def emit(payload, code):
    sys.stdout.write(json.dumps(payload, sort_keys=True) + "\n")
    sys.stdout.flush()
    return code


def load_config():
    try:
        st = os.stat(CONFIG_PATH)
    except OSError as exc:
        raise Refused("configuration %s is missing: %s" % (CONFIG_PATH, exc))
    if REQUIRE_ROOT_OWNED_CONFIG and (st.st_uid != 0 or st.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
        raise Refused("configuration must be owned by root and not writable by group or others")
    with open(CONFIG_PATH) as fh:
        config = json.load(fh)
    config.setdefault("allow_changes", False)
    config.setdefault("sites", {})
    config.setdefault("services", [])
    config.setdefault("restartable_services", [])
    config.setdefault("wp_cli", "/usr/local/bin/wp")
    config.setdefault("wp_runner", "/usr/local/lib/cc-gate/cc-wp")
    config.setdefault("sudo", "/usr/bin/sudo")
    config.setdefault("systemctl", "/usr/bin/systemctl")
    config.setdefault("site_helper", "/usr/local/lib/cc-gate/cc-site-helper")
    config.setdefault("timeout_seconds", 120)
    config.setdefault("slow_timeout_seconds", 600)
    config.setdefault("max_output_bytes", 1000000)
    return config


def parse_request(raw):
    if raw is None or not raw.strip():
        raise Refused("interactive sessions are not allowed; this key can only run cc-gate operations")
    if len(raw) > 2048:
        raise Refused("request too long")
    try:
        tokens = shlex.split(raw)
    except ValueError:
        raise Refused("request could not be parsed")
    if len(tokens) < 3 or tokens[0] != "cc-gate" or tokens[1] != "v1":
        raise Refused("only 'cc-gate v1 <operation> ...' requests are accepted")
    op, args = tokens[2], tokens[3:]
    if op not in OPS:
        raise Refused("unknown operation %r" % op)
    names = OPS[op][1]
    if len(args) != len(names):
        raise Refused("%s takes %d argument(s)" % (op, len(names)))
    return op, dict(zip(names, args))


def validate(op, args, config):
    kind = OPS[op][0]
    if kind == "change" and config.get("allow_changes") is not True:
        raise Refused("changes are switched off on this server (allow_changes is false in %s)" % CONFIG_PATH)
    if "site" in args:
        if not SITE_RE.match(args["site"]) or args["site"] not in config["sites"]:
            raise Refused("site %r is not configured on this server" % args["site"])
        site = config["sites"][args["site"]]
        for key in ("path", "user", "url"):
            if not site.get(key):
                raise Refused("site %r is missing %r in the configuration" % (args["site"], key))
        try:
            uid = pwd.getpwnam(site["user"]).pw_uid
        except KeyError:
            raise Refused("site %r: user %r does not exist" % (args["site"], site["user"]))
        if uid == 0 or uid == os.getuid():
            # The gate's own account holds the sudo rules for every site; a site must never run as it (or as root).
            raise Refused("site %r must run as its own unprivileged user, not as root or the gate account" % args["site"])
    if "slug" in args and not SLUG_RE.match(args["slug"]):
        raise Refused("invalid plugin name")
    if "service" in args:
        if not SERVICE_RE.match(args["service"]) or args["service"] not in config["services"]:
            raise Refused("service %r is not allowed" % args["service"])
        if op == "service_restart" and args["service"] not in config["restartable_services"]:
            raise Refused("service %r may not be restarted" % args["service"])
    if "onoff" in args and args["onoff"] not in ONOFF:
        raise Refused("expected on or off")


def current_user():
    return pwd.getpwuid(os.getuid()).pw_name


DEADLINE = [0.0]  # monotonic time when the current operation's budget runs out


def child_env():
    return {"PATH": SAFE_PATH, "LANG": "C.UTF-8", "HOME": pwd.getpwuid(os.getuid()).pw_dir or "/"}


def stop(proc):
    """Ask the program to stop (sudo passes SIGTERM on to the command, see run()), then kill it.

    The kill reaches only sudo: the gate's account cannot signal the site user's processes."""
    try:
        proc.terminate()
        proc.wait(timeout=STOP_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
    except OSError:
        pass


def run(argv, config):
    """Run argv without a shell within the operation's time budget; (exit status, stdout, stderr), output capped."""
    left = DEADLINE[0] - time.monotonic()
    if left <= 0:
        raise TimedOut("ran out of time before %s could start" % os.path.basename(argv[0]))
    try:
        # Its own session: sudo (1.8/1.9 on EL8/EL9) ignores a signal sent from its own process group, which
        # it would otherwise share with the gate, so stop()'s SIGTERM would never reach the command.
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd="/",
                                env=child_env(), start_new_session=True)
    except OSError as exc:
        raise Failed("could not start %s: %s" % (argv[0], exc))
    limit = config["max_output_bytes"]
    kept = {proc.stdout.fileno(): (bytearray(), limit), proc.stderr.fileno(): (bytearray(), limit // 4)}
    out_fd, err_fd = proc.stdout.fileno(), proc.stderr.fileno()
    sel = selectors.DefaultSelector()
    try:
        for fd in kept:
            sel.register(fd, selectors.EVENT_READ)
        while sel.get_map():
            left = DEADLINE[0] - time.monotonic()
            if left <= 0:
                stop(proc)
                raise TimedOut("did not finish within the time limit and was stopped; the operation may be incomplete")
            for key, _ in sel.select(left):
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    sel.unregister(key.fd)
                    continue
                buf, cap = kept[key.fd]
                if len(buf) < cap:  # keep the start; drain the rest so the program never blocks on a full pipe
                    buf.extend(chunk[:cap - len(buf)])
        try:
            code = proc.wait(timeout=max(DEADLINE[0] - time.monotonic(), 1))
        except subprocess.TimeoutExpired:
            stop(proc)
            raise TimedOut("did not finish within the time limit and was stopped; the operation may be incomplete")
    finally:
        sel.close()
        proc.stdout.close()
        proc.stderr.close()
    return code, bytes(kept[out_fd][0]).decode("utf-8", "replace"), bytes(kept[err_fd][0]).decode("utf-8", "replace")


def as_site_user(site, argv):
    """Run argv as the site's own system user (validate() made sure that is neither root nor the gate account)."""
    return [CONFIG["sudo"], "-n", "-u", site["user"], "--"] + argv


def wp(site, *wp_args, skip_code=True):
    argv = [CONFIG["wp_runner"], "--path=" + site["path"], "--no-color"]
    if skip_code:
        # Plugin and theme code is not loaded for these commands (must-use
        # plugins, drop-ins and wp-config.php still are, whenever WordPress loads).
        argv += ["--skip-plugins", "--skip-themes"]
    return as_site_user(site, argv + list(wp_args))


def wp_ok(site, *wp_args, skip_code=True):
    code, out, err = run(wp(site, *wp_args, skip_code=skip_code), CONFIG)
    if code != 0:
        raise Failed((err or out).strip()[-2000:] or "wp-cli exited with status %d" % code)
    return out.strip()


def wp_json(site, *wp_args):
    text = wp_ok(site, *wp_args)
    try:
        return json.loads(text or "[]")
    except ValueError:
        raise Failed("wp-cli did not return JSON")


def helper(site, op, site_key, *extra):
    code, out, err = run(as_site_user(site, [CONFIG["site_helper"], op, site_key] + list(extra)), CONFIG)
    try:
        data = json.loads(out)
    except ValueError:
        raise Failed((err or out).strip()[-2000:] or "site helper failed")
    if code != 0 or not data.get("ok"):
        if data.get("unchanged"):  # refused before touching anything
            raise Refused(data.get("error") or "site helper refused")
        raise Failed(data.get("error") or "site helper failed")
    return data["result"]


def utc_stamp():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


# ------------------------------------------------------------------ operations


def op_hello(args):
    return {
        "gate_version": GATE_VERSION,
        "user": current_user(),
        "uid": os.getuid(),
        "hostname": socket.gethostname(),
        "allow_changes": CONFIG.get("allow_changes") is True,
        "ops": sorted(op for op, (kind, _) in OPS.items() if kind == "read" or CONFIG.get("allow_changes") is True),
        "sites": {key: {"url": s.get("url", "")} for key, s in sorted(CONFIG["sites"].items())},
        "services": list(CONFIG["services"]),
        "restartable_services": list(CONFIG["restartable_services"]),
    }


def op_system_overview(args):
    with open("/proc/uptime") as fh:
        uptime = float(fh.read().split()[0])
    with open("/proc/loadavg") as fh:
        load = [float(x) for x in fh.read().split()[:3]]
    mem = {}
    with open("/proc/meminfo") as fh:
        for line in fh:
            key, _, rest = line.partition(":")
            if key in ("MemTotal", "MemAvailable"):
                mem[key] = int(rest.split()[0]) // 1024
    disks = []
    for mount in ("/", "/home", "/var", "/tmp"):
        if not os.path.ismount(mount):
            continue
        sv = os.statvfs(mount)
        total = sv.f_blocks * sv.f_frsize
        free = sv.f_bavail * sv.f_frsize
        used = total - sv.f_bfree * sv.f_frsize
        disks.append({"mount": mount, "total_gb": round(total / 1e9, 1), "free_gb": round(free / 1e9, 1),
                      "used_pct": round(100.0 * used / total, 1) if total else 0.0})
    os_name = ""
    try:
        with open("/etc/os-release") as fh:
            for line in fh:
                if line.startswith("PRETTY_NAME="):
                    os_name = line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return {"uptime_seconds": int(uptime), "load": load, "cpus": os.cpu_count(),
            "memory_mb": {"total": mem.get("MemTotal"), "available": mem.get("MemAvailable")}, "disks": disks, "os": os_name}


def op_service_status(args):
    code, out, err = run([CONFIG["systemctl"], "is-active", args["service"]], CONFIG)
    return {"service": args["service"], "state": (out.strip() or err.strip() or "unknown").splitlines()[0]}


def op_wp_core_version(args):
    return {"version": wp_ok(SITE, "core", "version")}


def op_wp_core_verify(args):
    # verify-checksums runs before WordPress loads, so the site's own code cannot answer for it.
    code, out, err = run(wp(SITE, "core", "verify-checksums"), CONFIG)
    text = (out + "\n" + err).strip()
    warnings = [line for line in text.splitlines() if line.startswith("Warning:")]
    # Extra files in wp-admin, wp-includes or the root are only warnings (exit 0) to WP-CLI,
    # but an unknown PHP file there is the usual place for a backdoor.
    extra = [line for line in warnings if "should not exist" in line][:200]
    problems = [line for line in warnings if "should not exist" not in line][:200]
    if code == 0 and not extra:
        return {"verified": True, "extra_files": [], "detail": text[-4000:]}
    if code != 0 and not problems and not extra:
        # No file was found wrong: the check itself failed (e.g. WordPress.org could not be reached).
        return {"verified": None, "detail": "checksums could not be checked: " + text[-1000:]}
    return {"verified": False, "files": problems, "extra_files": extra, "detail": text[-4000:]}


def op_wp_plugin_list(args):
    return {"plugins": wp_json(SITE, "plugin", "list", "--format=json", "--fields=name,status,version,update,update_version")}


def op_wp_theme_list(args):
    return {"themes": wp_json(SITE, "theme", "list", "--format=json", "--fields=name,status,version,update,update_version")}


def version_at_least(version, wanted):
    m = re.match(r"^([0-9]+)\.([0-9]+)", version)
    return bool(m) and (int(m.group(1)), int(m.group(2))) >= wanted


def op_wp_admins(args):
    fields = "--fields=ID,user_login,user_registered"
    admins = wp_json(SITE, "user", "list", "--role=administrator", "--format=json", fields)
    result = {"admins": admins}
    # Users whose role holds an administrator's powers under another name. Kept apart from "admins", so a Command
    # Center that never saw this list takes it as a new baseline, not as new accounts. Left out (not checked) before
    # WordPress 5.9, which ignores capability__in and would list every user.
    if version_at_least(wp_ok(SITE, "core", "version"), (5, 9)):
        known, result["capability_admins"] = {a.get("ID") for a in admins if isinstance(a, dict)}, []
        for user in wp_json(SITE, "user", "list", "--capability__in=" + ADMIN_CAPABILITIES, "--format=json", fields):
            if isinstance(user, dict) and user.get("ID") not in known:
                known.add(user.get("ID"))
                result["capability_admins"].append(user)
    code, out, err = run(wp(SITE, "super-admin", "list", "--format=json"), CONFIG)
    supers = []
    if code == 0:
        try:
            listed = json.loads(out or "[]")
        except ValueError:
            listed = []
        # WP-CLI prints [{"user_login": "..."}, ...]; plain names are taken too.
        for user in listed if isinstance(listed, list) else []:
            login = user.get("user_login") if isinstance(user, dict) else user
            if isinstance(login, str) and login and len(supers) < 500:
                supers.append(login)
    elif "multisite" not in (out + err).lower():  # a single site has no super admins
        raise Failed((err or out).strip()[-2000:] or "wp-cli exited with status %d" % code)
    result["super_admins"] = supers
    return result


def expected_urls():
    """(home, siteurl) as configured; "siteurl" is only needed when WordPress lives in its own folder."""
    home = SITE["url"].rstrip("/")
    return home, (SITE.get("siteurl") or home).rstrip("/")


def site_home(site):
    """The site user's home folder as the account database lists it ("" if unknown)."""
    try:
        return pwd.getpwnam(site["user"]).pw_dir.rstrip("/")
    except KeyError:
        return ""


def wordpress_folder(siteurl):
    """The sub-path WordPress seems to live in, or None.

    Only without a configured "siteurl": the current siteurl is the configured home plus a sub-path, the
    site's path ends with that URL path, and the rest of the path (the web root) lies inside the site user's
    home (home https://acme.com, siteurl https://acme.com/wp, path /home/acme/public_html/wp). Restoring
    siteurl to home would then break wp-admin. A root install (path /home/acme/public_html) never fits,
    whatever siteurl was set to: its web root would be the home folder or above it.
    """
    if SITE.get("siteurl"):
        return None
    home, siteurl = SITE["url"].rstrip("/"), siteurl.rstrip("/")
    if not siteurl.startswith(home + "/"):
        return None
    parts = urlsplit(siteurl)
    if parts.query or parts.fragment or not re.match(r"^(/[A-Za-z0-9._~-]+)+$", parts.path):
        return None
    path, user_home = SITE["path"].rstrip("/"), site_home(SITE)
    if not path.endswith(parts.path) or not user_home or not path[:-len(parts.path)].startswith(user_home + "/"):
        return None
    return siteurl[len(home):]


def op_wp_site_urls(args):
    home = wp_ok(SITE, "option", "get", "home")
    siteurl = wp_ok(SITE, "option", "get", "siteurl")
    want_home, want_siteurl = expected_urls()
    result = {"home": home, "siteurl": siteurl, "expected": want_home, "expected_siteurl": want_siteurl,
              "matches": home.rstrip("/") == want_home and siteurl.rstrip("/") == want_siteurl,
              "subdirectory_install_suspected": False}
    if wordpress_folder(siteurl):
        # wp_set_site_urls leaves this siteurl alone (it restores only a changed home). When siteurl is the one
        # difference, the configuration most likely just lacks "siteurl" (rather than the address having been hijacked).
        result["suspected_siteurl"] = siteurl.rstrip("/")
        result["subdirectory_install_suspected"] = home.rstrip("/") == want_home
    return result


def op_wp_maintenance_status(args):
    code, out, err = run(wp(SITE, "maintenance-mode", "is-active"), CONFIG)
    if code == 0:
        return {"active": True}
    if code == 1 and "Error:" not in out + err:
        return {"active": False}
    # Anything else (database down, PHP fatal error) is not an answer.
    raise Failed((err or out).strip()[-2000:] or "wp-cli exited with status %d" % code)


def op_wp_debug_log_status(args):
    return helper(SITE, "debug_log_status", ARGS["site"])


def op_wp_db_export(args):
    target_dir = os.path.join(CONFIG.get("backup_dir", "/var/lib/cc-gate/backups"), args["site"])
    # Unique even when two exports start in the same second (WP-CLI overwrites an existing file).
    target = os.path.join(target_dir, "%s-%s-%s.sql" % (args["site"], utc_stamp(), os.urandom(4).hex()))
    wp_ok(SITE, "db", "export", target, "--add-drop-table")
    return {"file": target}


def op_wp_set_site_urls(args):
    home, siteurl = expected_urls()
    before = op_wp_site_urls(args)
    folder = wordpress_folder(before["siteurl"])
    if folder and before["home"].rstrip("/") == home:
        raise Refused('WordPress appears to live in %s (siteurl is %s); set "siteurl" for this site in %s to its real '
                      'WordPress address (%s if it has no folder of its own) before restoring the addresses'
                      % (folder, before["siteurl"].rstrip("/"), CONFIG_PATH, home))
    wp_ok(SITE, "option", "update", "home", home)
    result = {"before": {"home": before["home"], "siteurl": before["siteurl"]}, "after": home, "after_siteurl": siteurl,
              "siteurl_kept": bool(folder)}
    if folder:
        # home was changed, and that redirect is undone now. siteurl stays on the site's own host: setting it to
        # home would break wp-admin if WordPress really lives in that folder.
        result["after_siteurl"] = before["siteurl"]
        return result
    try:
        wp_ok(SITE, "option", "update", "siteurl", siteurl)
    except Failed as exc:
        raise Failed("home was set to %s, but setting siteurl failed (it is still %s): %s" % (home, before["siteurl"], exc))
    return result


def op_wp_plugin_deactivate(args):
    return {"output": wp_ok(SITE, "plugin", "deactivate", args["slug"])}


def op_wp_plugin_activate(args):
    # Activation runs the plugin's activation hook, so plugin code is loaded here.
    return {"output": wp_ok(SITE, "plugin", "activate", args["slug"], skip_code=False)}


def op_wp_plugin_update(args):
    return {"output": wp_ok(SITE, "plugin", "update", args["slug"])}


def op_wp_plugin_reinstall(args):
    slug = args["slug"]
    # Only plugins that really come from WordPress.org: a custom or premium plugin
    # with the same folder name must never be replaced by WordPress.org's code.
    header = helper(SITE, "plugin_update_uri", ARGS["site"], slug)
    if not header.get("found"):
        raise Failed("plugin %s was not found in wp-content/plugins" % slug)
    uri = (header.get("update_uri") or "").strip()
    if uri and not WPORG_UPDATE_URI.match(uri):
        raise Refused("plugin %s declares Update URI %r, so it is not a WordPress.org plugin; it is not reinstalled from there" % (slug, uri))
    version = wp_ok(SITE, "plugin", "get", slug, "--field=version")
    if not re.match(r"^[0-9][0-9A-Za-z.\-]{0,40}$", version):
        raise Failed("unexpected plugin version %r" % version)
    code, out, err = run(wp(SITE, "plugin", "verify-checksums", slug, "--version=" + version), CONFIG)
    # WP-CLI skips (exit 0) a plugin it has no checksums for.
    if "could not retrieve the checksums" in (out + err).lower():
        raise Failed("WordPress.org has no checksums for %s %s (not a WordPress.org plugin, or WordPress.org could not be "
                     "reached); not reinstalling" % (slug, version))
    out = wp_ok(SITE, "plugin", "install", slug, "--force", "--version=" + version)
    return {"version": version, "output": out}


def op_wp_core_reinstall(args):
    version = wp_ok(SITE, "core", "version")
    if not re.match(r"^[0-9]+\.[0-9]+(\.[0-9]+)?$", version):
        raise Failed("unexpected WordPress version %r" % version)
    out = wp_ok(SITE, "core", "download", "--skip-content", "--force", "--version=" + version)
    return {"version": version, "output": out}


def op_wp_maintenance(args):
    action = "activate" if args["onoff"] == "on" else "deactivate"
    return {"output": wp_ok(SITE, "maintenance-mode", action)}


def op_wp_cache_flush(args):
    return {"output": wp_ok(SITE, "cache", "flush")}


def op_wp_rewrite_flush(args):
    # Rewrite rules come from plugins and themes too (shop, custom post types):
    # flushing without them would save rules that break those URLs.
    return {"output": wp_ok(SITE, "rewrite", "flush", skip_code=False)}


def op_debug_log_quarantine(args):
    return helper(SITE, "debug_log_quarantine", ARGS["site"])


def op_service_restart(args):
    code, out, err = run([CONFIG["sudo"], "-n", CONFIG["systemctl"], "restart", args["service"]], CONFIG)
    if code != 0:
        raise Failed((err or out).strip()[-2000:] or "restart failed")
    return {"service": args["service"], "restarted": True}


CONFIG = {}
SITE = {}
ARGS = {}


def log_line(entry):
    path = CONFIG.get("log_file")
    if not path:
        return
    try:
        with open(path, "a") as fh:
            fh.write(json.dumps(entry, sort_keys=True) + "\n")
    except OSError:
        pass
    try:
        import syslog

        syslog.openlog("cc-gate", 0, syslog.LOG_AUTH)
        syslog.syslog(syslog.LOG_INFO, json.dumps(entry, sort_keys=True))
    except Exception:  # noqa: BLE001 - syslog is best effort
        pass


def main():
    global CONFIG, SITE, ARGS
    started = time.time()
    raw = os.environ.get("SSH_ORIGINAL_COMMAND")
    op, args, code, payload = None, {}, 2, {}
    try:
        if os.geteuid() == 0 or os.getuid() == 0:
            raise Refused("cc-gate must not run as root; use a dedicated unprivileged account")
        CONFIG = load_config()
        op, args = parse_request(raw)
        budget = CONFIG["slow_timeout_seconds"] if op in SLOW_OPS else CONFIG["timeout_seconds"]
        DEADLINE[0] = time.monotonic() + budget
        validate(op, args, CONFIG)
        ARGS = args
        SITE = CONFIG["sites"].get(args.get("site", ""), {})
        result = globals()["op_" + op](args)
        payload, code = {"ok": True, "op": op, "gate_version": GATE_VERSION, "result": result}, 0
    except Refused as exc:
        payload, code = {"ok": False, "op": op, "gate_version": GATE_VERSION, "refused": True, "error": str(exc)}, 2
    except TimedOut as exc:
        payload, code = {"ok": False, "op": op, "gate_version": GATE_VERSION, "refused": False, "timed_out": True, "error": str(exc)}, 1
    except Failed as exc:
        payload, code = {"ok": False, "op": op, "gate_version": GATE_VERSION, "refused": False, "error": str(exc)}, 1
    except Exception as exc:  # noqa: BLE001 - never leak a traceback to the client
        payload, code = {"ok": False, "op": op, "gate_version": GATE_VERSION, "refused": False,
                         "error": "internal error: %s" % exc.__class__.__name__}, 1
    log_line({
        "at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "user": current_user(), "client": os.environ.get("SSH_CLIENT", "").split(" ")[0],
        "op": op, "args": args, "request": (raw or "")[:300], "exit": code, "ms": int((time.time() - started) * 1000),
    })
    return emit(payload, code)


if __name__ == "__main__":
    sys.exit(main())
