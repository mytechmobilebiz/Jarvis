# Infinite AI Command Center - environment template.
# Do not fill this in by hand: run scripts/init-env.ps1 (Windows) or
# scripts/init-env.sh, which writes .env with fresh random secrets.
# .env is private: never commit, email or upload it.

# --- Customer / owner settings ---------------------------------------------
ADMIN_EMAIL=admin@infinitemarketing.local     # first dashboard admin (also the n8n owner)
ADMIN_PASSWORD=                               # first sign-in password; change it in the dashboard later
TZ=America/New_York
DASHBOARD_PORT=8090                           # http://localhost:8090 (127.0.0.1 only)
N8N_PORT=5680                                 # n8n editor, http://localhost:5680 (127.0.0.1 only)

# Optional AI provider (metered, billed to the key's owner). Empty = rule-based planner.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_DAILY_REQUEST_CAP=200

# --- Secrets (generated; all different, all long and random) ---------------
POSTGRES_PASSWORD=                            # PostgreSQL superuser (used only by the init script and backups)
CC_DB_PASSWORD=                               # Command Center database role
N8N_DB_PASSWORD=                              # n8n database role
CC_SERVICE_TOKEN=                             # n8n -> Command Center API token
CC_SECRETS_KEY=                               # encrypts API keys customers enter in the dashboard; BACK THIS UP
N8N_WEBHOOK_SECRET=                           # Command Center -> n8n webhook header secret
N8N_ENCRYPTION_KEY=                           # n8n credential encryption; BACK THIS UP or stored n8n credentials are lost
N8N_OWNER_PASSWORD=                           # n8n editor sign-in

# --- Deployment / developer settings (leave as is unless you know why) -----
ENVIRONMENT=production                        # development enables /api/docs
COOKIE_SECURE=false                           # true once served over HTTPS
# REGISTRY=docker.io                          # image registry (a mirror, if Docker Hub is unreachable)
# EXTRA_CA_BUNDLE=                            # CA bundle for builds behind a TLS-intercepting proxy
# MONITOR_ALLOWED_PRIVATE_HOSTS=              # hosts on private IPs the monitor may check (e.g. a LAN staging site)
# N8N_API_KEY=                                # lets the Integrations page list n8n workflows
# CC_EDITION=developer                        # edition when no license is installed (developer = everything, not for sale)
# CC_LICENSE_PUBLIC_KEY=                      # Ed25519 public key that signs license files (commercial builds)
# WORKFLOW_ENGINE=n8n                         # n8n | webhook | none
# WORKFLOW_WEBHOOK_URL= / WORKFLOW_WEBHOOK_SECRET=   # for WORKFLOW_ENGINE=webhook (HMAC-signed POSTs)
