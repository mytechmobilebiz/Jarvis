node_modules/
runtime/
dist
dist-app
.env
*.local.json
.DS_Store

# The build-time engine payload (~320 MB): assembled by
# hud/scripts/build-vendor-payload.mjs, never committed.
hud/vendor/engine/*
!hud/vendor/engine/.gitkeep
# Lane C (voice): build-time staged voice payload and download cache.
hud/voice-assets/

# Platform swap directories. Both platforms build on ONE machine now, and the
# staging paths above are single and platform-specific, so a build swaps the
# other platform's tree aside under these names. They are the same build output
# as the ignored originals — and a `git add -A` during a swap once staged a
# gigabyte of DMG, Electron framework and ONNX models before the remote refused
# the push.
hud/dist-app-mac/
hud/dist-app-win/
hud/vendor/engine-darwin/
hud/vendor/engine-win/
hud/voice-assets-darwin/
hud/voice-assets-win/
hud/.voice-cache/

# Lane C (voice): build-time trust anchor, regenerated by fetch-voice-assets.
hud/build/voice-manifest-digest.json

# Platform-swap parking dirs. The build swaps payload/voice/dist-app between
# the mac and win sets, and parks the previous cut's output beside them. These
# are ignored BY PREFIX, not by exact name: the v1.5.2 cut renamed a parked
# output to `dist-app-v151-mac` to dodge the nesting trap, and an exact-name
# list let `git add -A` sweep a 540 MB DMG and a 350 MB installer into a
# commit. Anything shaped like a build output stays out of git, whatever it
# is called.
hud/dist-app-*/
hud/vendor/engine-*/
!hud/vendor/engine-patches/
hud/voice-assets-*/
